# Copy to .sandcastle/.env (never commit it). Pick ONE way to reach Claude:

# A) Claude Pro/Max subscription: run `claude setup-token` on your host.
CLAUDE_CODE_OAUTH_TOKEN=

# B) Anthropic API key:
# ANTHROPIC_API_KEY=

# C) An Anthropic-compatible LLM gateway. Also set MODEL in main.mts to the gateway's model id.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=

# GitHub token the agents use to read and close issues. `gh auth token` prints yours.
GH_TOKEN=
